<?xml version="1.0" encoding="UTF-8" ?>
<!-- <%= @config_comment %> - FusionInventory additional content for Raspberry Pi -->
<%- processor_models = (scope.lookupvar('::processors') || {})['models'] -%>
<%- processor_name = (processor_models.is_a?(Array) ? processor_models[0] : nil) || scope.lookupvar('::rpi_model') -%>
<%- processor_count = (scope.lookupvar('::processors') || {})['count'] || 1 -%>
<REQUEST>
  <CONTENT>
    <BIOS>
      <MMANUFACTURER>Raspberry Pi Foundation</MMANUFACTURER>
      <MMODEL><%= scope.lookupvar('::rpi_model') %></MMODEL>
      <MSN><%= scope.lookupvar('::rpi_serial') %></MSN>
      <SMANUFACTURER>Raspberry Pi Foundation</SMANUFACTURER>
      <SMODEL><%= scope.lookupvar('::rpi_model') %></SMODEL>
      <SSN><%= scope.lookupvar('::rpi_serial') %></SSN>
    </BIOS>
    <HARDWARE>
      <CHASSIS_TYPE>Board</CHASSIS_TYPE>
      <MEMORY><%= scope.lookupvar('::rpi_memory_mb') %></MEMORY>
      <PROCESSORN>1</PROCESSORN>
      <PROCESSORT><%= processor_name %></PROCESSORT>
    </HARDWARE>
    <CPUS>
      <ARCH><%= scope.lookupvar('::os')['architecture'] %></ARCH>
      <CORE><%= processor_count %></CORE>
      <NAME><%= processor_name %></NAME>
    </CPUS>
    <MEMORIES>
      <CAPACITY><%= scope.lookupvar('::rpi_memory_mb') %></CAPACITY>
      <CAPTION>Onboard Memory</CAPTION>
      <DESCRIPTION>System Memory</DESCRIPTION>
      <NUMSLOTS>1</NUMSLOTS>
      <SERIALNUMBER><%= scope.lookupvar('::rpi_serial') %></SERIALNUMBER>
      <TYPE>RAM</TYPE>
    </MEMORIES>
  </CONTENT>
</REQUEST>
