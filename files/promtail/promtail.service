# managed by shared_infra::promtail
# roughly based on https://github.com/grafana/loki/blob/main/tools/packaging/promtail.service
[Unit]
Description=Promtail service
After=network.target

[Service]
Type=simple
User=root
ExecStart=/usr/local/bin/promtail -config.file /opt/promtail/promtail.yaml
ExecReload=/bin/kill -HUP $MAINPID
# Give a reasonable amount of time for promtail to start up/shut down
TimeoutSec = 60
Restart = on-failure
RestartSec = 2

[Install]
WantedBy=multi-user.target
